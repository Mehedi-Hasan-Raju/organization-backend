
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum InternshipProgramStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum InternshipApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum InternshipInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CoursePaymentStatus {
  SUCCESS
  FAILED
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}


model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  tokenVersion  Int        @default(0)

  emailVerificationCodes EmailVerificationCode[]
  passwordResetCodes     PasswordResetCode[]

  headedDepartment Department?  @relation("DepartmentHead")
  teamMemberships         TeamMember[]
  applications            InternshipApplication[] @relation("InternshipApplicant")
  reviewedApplications    InternshipApplication[] @relation("InternshipReviewer")
  scheduledInterviews InternshipInterview[] @relation("InterviewScheduler")
  createdCourses         Course[]           @relation("CourseCreator")
  coursePayments           CoursePayment[]
  courseEnrollments        CourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  headUserId String? @unique
  headUser   User?   @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)

  members TeamMember[]
  internshipPrograms InternshipProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("departments")
}

model TeamMember {
  id            String           @id @default(cuid())
  userId        String
  departmentId  String
  designation   String
  isSupervisor  Boolean          @default(false)
  status        TeamMemberStatus @default(ACTIVE)
  joinedAt      DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@index([status])
  @@map("team_members")
}


model InternshipProgram {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  requirements String?
  seats       Int      @default(1)
  deadline    DateTime?
  status      InternshipProgramStatus @default(DRAFT)

  departmentId String
  department   Department @relation( fields: [departmentId],references: [id],onDelete: Restrict)

  applications InternshipApplication[]

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([deadline])
  @@map("internship_programs")
}

model InternshipApplication {
  id          String @id @default(cuid())
  userId      String
  programId   String
  cvUrl       String?
  coverLetter String?

  status InternshipApplicationStatus @default(PENDING)
  adminNote String?

  reviewerId String?
  reviewer   User? @relation(  "InternshipReviewer", fields: [reviewerId], references: [id],onDelete: SetNull)

  user User @relation( "InternshipApplicant",fields: [userId], references: [id],onDelete: Cascade)

  program InternshipProgram @relation( fields: [programId],references: [id],onDelete: Restrict)
 interviews InternshipInterview[]

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
  @@index([programId, status])
  @@index([userId])
  @@index([reviewerId])
  @@map("internship_applications")
}


model InternshipInterview {
  id            String @id @default(cuid())
  applicationId String

  scheduledAt    DateTime
  durationMinutes Int @default(30)
  meetingUrl     String?
  location       String?
  notes          String?

  status InternshipInterviewStatus @default(SCHEDULED)

  interviewerId String?
  interviewer   User? @relation( "InterviewScheduler", fields: [interviewerId],references: [id],  onDelete: SetNull)

  application InternshipApplication @relation( fields: [applicationId],  references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([interviewerId])
  @@index([status])
  @@map("internship_interviews")
}



model Notice {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  summary     String?
  content     String       @db.Text
  status      NoticeStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
  @@map("notices")
}


model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  shortDescription String?   @db.VarChar(500)
  description   String       @db.Text
  thumbnailUrl  String?
  price         Decimal      @default(0) @db.Decimal(10, 2)
  durationHours Int          @default(0)
  status        CourseStatus @default(DRAFT)

  createdById   String
  createdBy     User         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  modules       CourseModule[]
  enrollments   CourseEnrollment[]
  payments      CoursePayment[]

  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([createdById])
  @@map("courses")
}

model CourseModule {
  id          String         @id @default(cuid())
  courseId    String
  title       String
  description String?        @db.Text
  order       Int            @default(0)

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId, order])
  @@map("course_modules")
}

model CourseLesson {
  id          String                @id @default(cuid())
  moduleId    String
  title       String
  description String?               @db.Text
  content     String?               @db.Text
  videoUrl    String?
  durationMinutes Int               @default(0)
  order       Int                   @default(0)
  isPreview   Boolean               @default(false)

  module      CourseModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses  CourseLessonProgress[]

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([moduleId, order])
  @@map("course_lessons")
}

model CoursePayment {
  id              String              @id @default(cuid())
  userId          String
  courseId        String
  amount          Decimal             @db.Decimal(10, 2)
  status          CoursePaymentStatus @default(SUCCESS)
  paymentMethod   String              @default("DEMO")
  transactionId   String              @unique
  isDemo          Boolean             @default(true)

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)

  createdAt       DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([courseId, status])
  @@map("course_payments")
}

model CourseEnrollment {
  id              String                  @id @default(cuid())
  userId          String
  courseId        String
  status          CourseEnrollmentStatus  @default(ACTIVE)
  enrolledAt      DateTime                @default(now())
  completedAt     DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  progresses      CourseLessonProgress[]

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("course_enrollments")
}

model CourseLessonProgress {
  id            String           @id @default(cuid())
  enrollmentId  String
  lessonId      String
  isCompleted   Boolean          @default(false)
  completedAt   DateTime?

  enrollment    CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson        CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId, isCompleted])
  @@map("course_lesson_progress")
}